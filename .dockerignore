# Docker build context exclusions — shared across API and OCR services

# Environments & secrets
.env
.env.*
!.env.example
.env.local
.env.*.local

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
package-lock.json
pnpm-lock.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
dist/
build/
venv/
.venv
env/
pip-log.txt
pip-delete-this-directory.txt

# Version control & CI
.git/
.gitignore
.github/
.gitlab-ci.yml
.travis.yml

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Documentation & tests (optional — exclude from build)
*.md
test/
tests/
*.test.js
*.spec.js
coverage/
.nyc_output/

# Logs
*.log
*.out
*.err

# Temporary
tmp/
temp/
*.tmp
