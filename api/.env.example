# Family Finance API — connection & JWT config
# Copy to .env and fill in. This file (.env.example) is a template:
# keep credentials OUT of it. Create your real .env from it.

PORT=4000

# Local Postgres (current) — change DATABASE_URL when migrating to Aiven
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DBNAME

# JWT signing secret — generate a long random string
JWT_SECRET=replace-with-a-long-random-secret
