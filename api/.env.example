# FamFin API - connection & JWT config
# Copy to .env and fill in. This file (.env.example) is a template:
# keep credentials OUT of it. Create your real .env from it.

PORT=4000

# Hosted Supabase Postgres, connected via the SESSION pooler (port 6543).
# Use the session pooler (not the transaction pooler) to preserve BEGIN/COMMIT
# so the account-balance sync trigger behaves correctly.
# Format:
#   postgres://<user>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://USER:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# JWT signing secret - generate a long random string
JWT_SECRET=replace-with-a-long-random-secret
