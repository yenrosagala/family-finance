# FamFin API — multi-stage build for production
# Build context must be project root

# Stage 1: Dependencies
FROM node:20-alpine AS deps
WORKDIR /app
COPY api/package*.json ./
RUN npm ci --only=production

# Stage 2: Build
FROM node:20-alpine AS builder
WORKDIR /app
COPY api/package*.json ./
RUN npm ci

# Stage 3: Runtime
FROM node:20-alpine
WORKDIR /app

# Copy prod dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy app source
COPY api/src ./src
COPY schema.sql ./

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
USER nodejs

ENV NODE_ENV=production
ENV PORT=4000

EXPOSE 4000

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:4000/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

CMD ["node", "src/server.js"]
