# FamFin API - connection & JWT config
# Copy to .env and fill in. This file (.env.example) is a template:
# keep credentials OUT of it. Create your real .env from it.

PORT=4000

# ── Multi-tenant setup ──────────────────────────────────────────────────────
# One global Postgres project (Supabase/Aiven) that YOU (the developer) own.
# It stores only app_users + households_registry (see src/db/master-schema.sql).
# It never holds any household's financial data — that lives in a dedicated
# schema per household, created on demand by src/services/provision.js.
#
# MUST be a session-mode connection, not a transaction-mode pooler.
# db.js refuses to start against a URL that looks like a transaction pooler
# (port 6543 or pgbouncer=true) because SET search_path and BEGIN/COMMIT are
# not reliably honored per-request under transaction pooling — that's the
# difference between correct household isolation and a silent data leak.
#
# Supabase: use the "Session" pooler (port 5432), NOT the "Transaction"
# pooler (port 6543). Format:
#   postgres://<user>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Aiven / a direct Postgres connection: any normal connection string works.
MASTER_DATABASE_URL=postgres://USER:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
# Local Docker Compose (postgres service, no SSL): append ?sslmode=disable
#   MASTER_DATABASE_URL=postgres://famfin:famfin@db:5432/famfin?sslmode=disable

# JWT signing secret - generate a long random string
JWT_SECRET=replace-with-a-long-random-secret
